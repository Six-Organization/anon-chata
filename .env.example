# Konfigurasi root untuk docker compose. Salin ke `.env` (ter-gitignore).
# Ada 2 skenario: LOKAL (pakai nginx, HTTP) atau PRODUKSI VPS (pakai Caddy, HTTPS).

# ================= LOKAL (development) =================
# Nyalakan edge nginx lokal + pilih port host.
COMPOSE_PROFILES=local
WEB_PORT=8090

# ================= PRODUKSI (VPS) =====================
# Untuk produksi: HAPUS/KOSONGKAN COMPOSE_PROFILES di atas, lalu set berikut:
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# DOMAIN=chat.domainmu.com        # subdomain kamu (A record -> IP VPS)
# EMAIL=kamu@domainmu.com         # opsional, untuk notifikasi Let's Encrypt
#
# Caddy akan otomatis menerbitkan & memperbarui sertifikat HTTPS.

# ================= Umum ===============================
# Kredensial PostgreSQL — WAJIB ganti password kuat di produksi!
POSTGRES_USER=chat
POSTGRES_PASSWORD=chatpass
POSTGRES_DB=chatdb

# Origin FE yang diizinkan BE. Same-origin via edge (nginx/Caddy) -> "*" aman.
CORS_ORIGIN=*

# Public env FE (di-inline saat build image). Same-origin -> kosongkan.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=

# ============ Email alert (fitur decoy PIN) ============
# 3x gagal PIN -> chat pindah ke room baru + kode dikirim ke ALERT_EMAIL.
# Gmail: aktifkan 2FA lalu buat "App Password" 16 digit sebagai MAIL_PASSWORD.
# JANGAN commit nilai asli — isi hanya di .env VPS (file ini contoh saja).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=shalltears666@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_ADDRESS=shalltears666@gmail.com
MAIL_FROM_NAME=Shalltears Clothing Store
ALERT_EMAIL=Rattpoison6661@gmail.com
