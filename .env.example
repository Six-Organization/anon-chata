# Konfigurasi root untuk docker compose (opsional; compose punya default).
# Salin ke `.env` (ter-gitignore) lalu sesuaikan.

# Port host untuk Nginx.
#  - Lokal (hindari tabrakan project lain): 8090
#  - VPS produksi: 80 (default)
WEB_PORT=8090

# Kredensial PostgreSQL (WAJIB ganti password di produksi!)
POSTGRES_USER=chat
POSTGRES_PASSWORD=chatpass
POSTGRES_DB=chatdb

# Origin FE yang diizinkan BE. Same-origin via Nginx -> "*" aman (tanpa cookie).
CORS_ORIGIN=*

# Public env FE (di-inline saat build image). Same-origin via Nginx -> kosongkan:
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
