# Frontend environment (public — di-bundle ke browser)

# Origin server BE (FE menambahkan prefix /api sendiri).
#  - Lokal (BE terpisah): http://localhost:4000
#  - Prod same-origin via Nginx: kosongkan (default ke origin halaman)
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL Socket.IO backend.
#  - Lokal: http://localhost:4000
#  - Prod same-origin via Nginx: kosongkan (default ke origin halaman)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
