// Prisma schema — Anonymous 3-person group chat
// Lihat kontrak di /CLAUDE.md (bagian 4. Data Model).

generator client {
  provider      = "prisma-client-js"
  // native untuk dev lokal; debian-openssl-3.0.x untuk image Docker (node:20-slim).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id        String   @id @default(uuid())
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  participants Participant[]
  messages     Message[]

  @@map("rooms")
}

model Participant {
  id       String   @id @default(uuid())
  roomId   String   @map("room_id")
  nickname String
  socketId   String?   @map("socket_id")
  joinedAt   DateTime  @default(now()) @map("joined_at")
  isActive   Boolean   @default(true) @map("is_active")
  lastReadAt DateTime? @map("last_read_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, isActive])
  @@map("participants")
}

model Message {
  id        String    @id @default(uuid())
  roomId    String    @map("room_id")
  nickname  String
  content   String
  type      String    @default("text") // "text" | "image"
  imageUrl  String?   @map("image_url")
  expiresAt DateTime? @map("expires_at") // gambar: created_at + 24 jam
  createdAt DateTime  @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([type, expiresAt])
  @@map("messages")
}
