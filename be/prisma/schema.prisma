// Prisma schema — Anonymous 3-person group chat
// Lihat kontrak di /CLAUDE.md (bagian 4. Data Model).

generator client {
  provider      = "prisma-client-js"
  // native untuk dev lokal; debian-openssl-3.0.x untuk image Docker (node:20-slim).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id           String   @id @default(uuid())
  code         String   @unique
  pin          String? // PIN 4 digit opsional (gate masuk room)
  pinFailCount Int      @default(0) @map("pin_fail_count") // gagal PIN beruntun
  createdAt    DateTime @default(now()) @map("created_at")

  participants Participant[]
  messages     Message[]

  @@map("rooms")
}

model Participant {
  id       String   @id @default(uuid())
  roomId   String   @map("room_id")
  nickname String
  socketId   String?   @map("socket_id")
  clientId   String?   @map("client_id")
  joinedAt   DateTime  @default(now()) @map("joined_at")
  isActive   Boolean   @default(true) @map("is_active")
  lastReadAt DateTime? @map("last_read_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, isActive])
  @@index([roomId, clientId])
  @@map("participants")
}

model Message {
  id        String    @id @default(uuid())
  roomId    String    @map("room_id")
  nickname  String
  clientId  String?   @map("client_id")
  content   String
  type      String    @default("text") // "text" | "image" | "audio" | "video"
  imageUrl  String?   @map("image_url") // URL media (image/audio/video)
  replyToId String?   @map("reply_to_id")
  expiresAt DateTime? @map("expires_at") // media: created_at + 24 jam
  createdAt DateTime  @default(now()) @map("created_at")

  room      Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  replyTo   Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("MessageReply")
  reactions MessageReaction[]

  @@index([roomId, createdAt])
  @@index([type, expiresAt])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  clientId  String   @map("client_id")
  nickname  String
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, clientId]) // 1 reaksi per orang per pesan
  @@index([messageId])
  @@map("message_reactions")
}
