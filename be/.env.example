# Backend environment

# Koneksi PostgreSQL (lokal). Untuk Docker, compose meng-inject nilai sendiri.
DATABASE_URL="postgresql://chat:chatpass@localhost:5432/chatdb?schema=public"

# Port HTTP + Socket.IO server
PORT=4000

# Origin FE yang diizinkan CORS.
#  - Lokal: http://localhost:3000
#  - Prod same-origin (via Nginx): "*" aman karena tidak pakai cookie/credentials.
# Bisa multiple, pisahkan dengan koma: http://localhost:3000,https://domain.com
CORS_ORIGIN=http://localhost:3000
